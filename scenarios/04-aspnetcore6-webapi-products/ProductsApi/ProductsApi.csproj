<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b1c9c8f0-5e4a-4c1a-9b0e-7a6d5f4e3c2d</UserSecretsId>
    <!-- Lets the compiled net6.0 app execute in this sandbox, which only
         ships newer shared runtimes. Not needed in a real net6.0 host. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Period-correct .NET 6 packages. Left un-upgraded on purpose so a
         migration to .NET 10 has real NU1605/NU1902-style package bumps
         to work through, not just a TargetFramework edit. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="6.0.36" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="6.0.36">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Carried forward from a .NET Framework-era API that used Json.NET
         attributes on its DTOs; a real migration has to decide whether to
         keep this compatibility shim or finish moving to System.Text.Json. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="6.0.36" />
  </ItemGroup>

</Project>
