<?xml version="1.0" encoding="utf-8"?>
<!--
  Client-side WCF configuration, generated (in a real project) by
  "Add Service Reference" / svcutil.exe from the service's WSDL. The
  client's <system.serviceModel> block must match the server's binding
  shape by hand; there is no compile-time link between the two, which
  is itself a fragile legacy pattern worth calling out during migration
  (a typed HttpClient/gRPC client has no equivalent split config surface).
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="ProductServiceBinding" maxReceivedMessageSize="1048576" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:44301/ProductService.svc"
                binding="basicHttpBinding" bindingConfiguration="ProductServiceBinding"
                contract="ServiceReference.IProductService" name="ProductServiceEndpoint" />
    </client>
  </system.serviceModel>
</configuration>
